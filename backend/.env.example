# Copy to backend/.env and fill in what you use. Everything is optional.

ENV=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Sandbox ---
# Leave empty for Docker's default runtime. Use "runsc" (gVisor) in production.
CONTAINER_RUNTIME=
RUN_TIMEOUT_S=5
COMPILE_TIMEOUT_S=15
MAX_CONCURRENT_RUNS=4
CPU_LIMIT=0.5
# Pull missing sandbox images in the background on startup
PREPULL_IMAGES=true
IMAGE_PYTHON=python:3.12-slim
IMAGE_JAVASCRIPT=node:20-alpine
IMAGE_CPP=gcc:14
IMAGE_JAVA=eclipse-temurin:21-jdk

# --- LLM ---
# ollama | groq | openrouter | anthropic
DEFAULT_PROVIDER=ollama
LLM_TEMPERATURE=0.1

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Leave a *_MODEL empty to use the first model the provider lists; pick one in the UI.
GROQ_API_KEY=
GROQ_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
